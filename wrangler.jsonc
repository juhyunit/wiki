// 시연용 데모(서버 없는 정적 사이트)를 Cloudflare Workers 정적 자산으로 올리는 설정.
// 자동 배포(Workers Builds): GitHub main에 push → Cloudflare가 아래 순서로 빌드·배포
//   빌드 명령:  npm ci --prefix frontend && npm run build:demo --prefix frontend
//   배포 명령:  npx wrangler deploy
// 수동 배포도 같은 두 명령을 저장소 루트에서 실행하면 된다(처음 한 번 npx wrangler login).
{
  "name": "workwiki",
  "compatibility_date": "2026-11-04",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "frontend/dist-demo"
  }
}
